{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cmnzjhpbidwmishalkwu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "field-approve",
      "version": "0.1.0",
      "title": "Field Approve"
    },
    "tools": [
      {
        "name": "list_jobs",
        "title": "List jobs",
        "description": "List the signed-in user's jobs with their GC and address.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_change_directives",
        "title": "List change directives",
        "description": "List change directives, optionally filtered by status or job, with amounts and dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "draft",
                "pending",
                "approved",
                "rejected"
              ]
            },
            "job_id": {
              "description": "Filter by job id.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Max rows, default 50.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_draft_directive",
        "title": "Create draft change directive",
        "description": "Create a draft change directive on a job with a title, scope and lump-sum amount.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Job id from list_jobs."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "description": "Scope of the extra work.",
              "type": "string",
              "maxLength": 5000
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "description": "Lump-sum dollar amount."
            }
          },
          "required": [
            "job_id",
            "title",
            "amount"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
